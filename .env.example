# 한 장 제주 환경 변수 예시. 모두 선택 사항이며, 지정하지 않으면 아래 기본값으로 동작한다.
# 이 프로그램은 .env 파일을 자동으로 읽지 않는다. Windows는 "시스템 환경 변수 편집"에서,
# 명령 프롬프트에서는 set 이름=값 으로 지정한 뒤 실행한다. API 키는 필요 없다(외부 AI API를 쓰지 않음).

# 로컬 AI 모델 이름 (Ollama). 기본: qwen3:1.7b
JEJU_MODEL=qwen3:1.7b

# Ollama 주소. 이 PC(127.0.0.1, localhost, ::1)만 허용하고 다른 주소는 거부한다.
JEJU_OLLAMA_URL=http://127.0.0.1:11434

# 이용자가 넣은 CSV를 두는 작업 폴더. 기본: 설치판은 %LOCALAPPDATA%\HanJangJeju\workspace
# JEJU_WORKSPACE=C:\HanJangJeju\workspace

# 1이면 시작할 때 남은 작업을 자동으로 지우지 않는다(개발용).
# JEJU_KEEP_WORKSPACE=1

# 1이면 시작할 때 예측과 모델 미리 점검을 건너뛴다(테스트용).
# JEJU_SKIP_WARMUP=1
