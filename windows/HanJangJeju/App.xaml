<Application x:Class="HanJangJeju.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="Grey100" Color="#F2F4F6" />
    <SolidColorBrush x:Key="Grey600" Color="#6B7684" />
    <SolidColorBrush x:Key="Grey900" Color="#191F28" />
    <SolidColorBrush x:Key="Teal500" Color="#0E7C86" />
    <FontFamily x:Key="UiFont">Malgun Gothic, Segoe UI</FontFamily>
  </Application.Resources>
</Application>
